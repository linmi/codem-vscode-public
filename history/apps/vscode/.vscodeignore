AGENTS.md
.prettierignore
.env
.env.*

# Include dist/ directory for compiled extension (production)
!dist/**
# The include above must not re-include development-only build metadata.
dist/**/*.map
dist/**/*.d.ts
dist/**/*.d.cts
dist/**/*.d.mts
dist/tests/**

# Packages carry only the CodeM runtime and credential broker. Exclude legacy
# Kilo binaries, parsers, sandbox helpers and retired voice assets even when a
# local development build has left them in bin/.
bin/**
!bin/app-server/**

# Include WAV assets used by extension-host notification playback
!audio-wav/**
