// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VSCode - Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/apps/vscode",
        "--new-window",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "VSCode - Compile"
    },
    {
      "name": "VSCode - Run Extension (Local Backend)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/apps/vscode",
        "--new-window",
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "VSCode - Compile",
      "env": {
        "KILO_API_URL": "http://localhost:3000"
      }
    },
    {
      "name": "VSCode - Run Extension (Isolated)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run extension:isolated -- --workspace \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}/apps/vscode"
    },
    {
      "name": "VSCode - Run Extension (Isolated Clean)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run extension:isolated:clean -- --workspace \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}/apps/vscode"
    }
  ]
}
