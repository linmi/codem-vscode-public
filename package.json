{
  "name": "@codem/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build:vscode": "pnpm --filter codem build",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:windows": "node --test --experimental-strip-types packages/app-server/tests/runtime.test.ts packages/app-server/tests/rpc.test.ts packages/app-server/tests/processLifecycle.test.ts packages/app-server/tests/threadWorkspace.test.ts apps/vscode/tests/vscodeExecutable.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:jetbrains": "pnpm --filter @codem/jetbrains check",
    "test:architecture": "pnpm --filter codem exec node --test --experimental-strip-types tests/architecture.test.ts tests/sourceLayout.test.ts tests/fileNaming.test.ts tests/workspaceHygiene.test.ts",
    "test:shutdown": "node --test --experimental-strip-types --test-name-pattern=\"shutdown gate\" apps/vscode/tests/chatController.test.ts packages/app-server/tests/host.test.ts",
    "package:vscode": "pnpm --filter codem package:vsix",
    "test:packaging": "pnpm --filter codem exec node --test --experimental-strip-types tests/vsixPackage.test.ts tests/bundleNotices.test.ts"
  },
  "devDependencies": {
    "oxlint": "1.83.0"
  }
}
