{
  "name": "@codem/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build:vscode": "pnpm --filter codem build",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:architecture": "pnpm --filter codem exec node --test --experimental-strip-types tests/architecture.test.ts tests/sourceLayout.test.ts",
    "test:shutdown": "node --test --experimental-strip-types --test-name-pattern=\"shutdown gate\" apps/vscode/tests/chatController.test.ts packages/app-server/tests/host.test.ts"
  },
  "devDependencies": {
    "oxlint": "1.83.0"
  }
}
