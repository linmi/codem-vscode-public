.vscode/**
.vscode-test/**
.storybook/**
out/**
node_modules/**
src/**
webview-ui/**
script/**
tests/**
docs/**
.gitignore
.yarnrc
.npmrc
bunfig.toml
knip.json
CHANGELOG.md
esbuild.js
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
AGENTS.md
.prettierignore
.env
.env.*

# Include dist/ directory for compiled extension (production)
!dist/**
# The include above must not re-include development-only build metadata.
dist/**/*.map
dist/**/*.d.ts
dist/**/*.d.cts
dist/**/*.d.mts

# Include bin/ directory for the transitional CLI and bundled CodeM App Server runtimes.
!bin/**
# .cli-version is a local-source build marker written by local-bin.ts. It must
# not ship in the VSIX, otherwise production installs are detected as local
# builds and may inject a dev-only bwrap fallback (see ServerManager.localCli).
bin/.cli-version

# Legacy notification audio is not consumed by the App Server-only entry.
audio-wav/**
