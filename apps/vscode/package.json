{
  "name": "codem",
  "displayName": "CodeM",
  "description": "CodeM coding assistant for VS Code, powered by App Server.",
  "version": "0.2.0",
  "private": true,
  "publisher": "codem",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "icon": "assets/codem.png",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "可以查看界面；连接和执行任务需要信任工作区。"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "CodeM 需要可访问的工作区文件系统和本地进程。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codem.open",
        "title": "打开聊天",
        "category": "CodeM"
      },
      {
        "command": "codem.history",
        "title": "历史会话",
        "category": "CodeM",
        "icon": "$(history)"
      },
      {
        "command": "codem.newChat",
        "title": "新建会话",
        "category": "CodeM",
        "icon": "$(add)"
      },
      {
        "command": "codem.connect",
        "title": "连接工作区",
        "category": "CodeM",
        "icon": "$(plug)"
      },
      {
        "command": "codem.signIn",
        "title": "登录",
        "category": "CodeM"
      },
      {
        "command": "codem.showOutput",
        "title": "查看日志",
        "category": "CodeM"
      },
      {
        "command": "codem.focusChatInput",
        "title": "聚焦聊天输入框",
        "category": "CodeM"
      },
      {
        "command": "codem.openInTab",
        "title": "在编辑器标签页打开聊天",
        "category": "CodeM"
      },
      {
        "command": "codem.openInSidebar",
        "title": "将聊天移回侧栏",
        "category": "CodeM"
      },
      {
        "command": "codem.settings",
        "title": "打开设置",
        "category": "CodeM"
      },
      {
        "command": "codem.stop",
        "title": "停止生成",
        "category": "CodeM"
      },
      {
        "command": "codem.addToContext",
        "title": "将选区加入上下文",
        "category": "CodeM"
      },
      {
        "command": "codem.explainCode",
        "title": "解释选中代码",
        "category": "CodeM"
      },
      {
        "command": "codem.fixCode",
        "title": "修复选中代码",
        "category": "CodeM"
      },
      {
        "command": "codem.improveCode",
        "title": "改进选中代码",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalSelectionToContext",
        "title": "复制终端选区并加入上下文",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalAddToContext",
        "title": "最近终端输出加入上下文",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalExplainCommand",
        "title": "解释最近终端命令",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalFixCommand",
        "title": "分析最近终端错误",
        "category": "CodeM"
      },
      {
        "command": "codem.generateCommitMessage",
        "title": "生成暂存变更的提交说明",
        "category": "CodeM",
        "icon": "$(sparkle)"
      },
      {
        "command": "codem.generateCompletion",
        "title": "生成行内补全",
        "category": "CodeM"
      },
      {
        "command": "codem.cancelCompletion",
        "title": "取消行内补全",
        "category": "CodeM"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codem",
          "title": "CodeM",
          "icon": "assets/codemActivity.svg"
        }
      ]
    },
    "views": {
      "codem": [
        {
          "type": "webview",
          "id": "codem.chat",
          "name": "聊天",
          "contextualTitle": "CodeM"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codem.history",
          "when": "view == codem.chat",
          "group": "navigation@2"
        },
        {
          "command": "codem.newChat",
          "when": "view == codem.chat",
          "group": "navigation@1"
        },
        {
          "command": "codem.connect",
          "when": "view == codem.chat",
          "group": "navigation@3"
        },
        {
          "command": "codem.signIn",
          "when": "view == codem.chat"
        },
        {
          "command": "codem.showOutput",
          "when": "view == codem.chat"
        },
        {
          "command": "codem.openInTab",
          "when": "view == codem.chat"
        },
        {
          "command": "codem.settings",
          "when": "view == codem.chat"
        }
      ],
      "editor/context": [
        {
          "submenu": "codem.editorActions",
          "group": "1_codem",
          "when": "editorHasSelection && isWorkspaceTrusted"
        }
      ],
      "codem.editorActions": [
        {
          "command": "codem.addToContext",
          "group": "actions@0"
        },
        {
          "command": "codem.explainCode",
          "group": "actions@1"
        },
        {
          "command": "codem.fixCode",
          "group": "actions@2"
        },
        {
          "command": "codem.improveCode",
          "group": "actions@3"
        }
      ],
      "editor/title": [
        {
          "command": "codem.openInSidebar",
          "when": "activeWebviewPanelId == codem.editor",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "submenu": "codem.terminalActions",
          "group": "codem",
          "when": "isWorkspaceTrusted"
        }
      ],
      "codem.terminalActions": [
        {
          "command": "codem.terminalSelectionToContext",
          "when": "terminalTextSelected"
        },
        {
          "command": "codem.terminalAddToContext"
        },
        {
          "command": "codem.terminalExplainCommand"
        },
        {
          "command": "codem.terminalFixCommand"
        }
      ],
      "scm/title": [
        {
          "command": "codem.generateCommitMessage",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "scm/input": [
        {
          "command": "codem.generateCommitMessage",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "submenus": [
      {
        "id": "codem.editorActions",
        "label": "CodeM"
      },
      {
        "id": "codem.terminalActions",
        "label": "CodeM"
      }
    ],
    "keybindings": [
      {
        "command": "codem.focusChatInput",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "codem.addToContext",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "editorTextFocus && editorHasSelection && isWorkspaceTrusted"
      },
      {
        "command": "codem.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "focusedView == codem.chat || activeWebviewPanelId == codem.editor"
      },
      {
        "command": "codem.generateCompletion",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus && !editorReadonly && isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "CodeM",
      "properties": {
        "codem.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "在可信工作区打开聊天时自动连接。关闭后使用连接命令。",
          "scope": "window"
        },
        "codem.chat.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "enumDescriptions": [
            "Enter 发送，Shift+Enter 换行",
            "Ctrl+Enter（macOS 为 Cmd+Enter）发送，Enter 换行"
          ],
          "default": "enter",
          "description": "聊天输入框的发送按键。",
          "scope": "window"
        },
        "codem.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用手动行内补全。仅显式调用时请求模型，使用当前空闲 CodeM 连接。",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "watch": "node --experimental-strip-types scripts/build.ts --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview/tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:extension": "node --experimental-strip-types scripts/smoke.ts",
    "test:live": "node --experimental-strip-types scripts/smoke.ts --live",
    "test:acceptance": "node --experimental-strip-types scripts/acceptance.ts"
  },
  "dependencies": {
    "@codem/app-server": "workspace:*",
    "@codem/session-history": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dompurify": "3.4.15",
    "get-nonce": "1.0.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.47.0",
    "marked": "18.0.13",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-router": "1.170.38",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.105.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:"
  },
  "activationEvents": [
    "onWebviewPanel:codem.editor",
    "onLanguage",
    "onTerminalShellIntegration:*"
  ]
}
