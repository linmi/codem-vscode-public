{
  "name": "codem",
  "displayName": "CodeM",
  "description": "CodeM coding agent for VS Code, powered by CodeM Core App Server.",
  "version": "0.1.1",
  "publisher": "codem",
  "icon": "assets/icons/codem.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmi/codem-vscode.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "CodeM"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "codem",
    "agent",
    "coding agent",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "codem-logo": {
        "description": "CodeM logo",
        "default": {
          "fontPath": "assets/icons/codem-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codem-ActivityBar",
          "title": "CodeM",
          "icon": "assets/icons/codem-light.svg",
          "darkIcon": "assets/icons/codem-dark.svg"
        }
      ]
    },
    "views": {
      "codem-ActivityBar": [
        {
          "type": "webview",
          "id": "codem.SidebarProvider",
          "name": "CodeM"
        }
      ]
    },
    "commands": [
      {
        "command": "codem.plusButtonClicked",
        "title": "New Task",
        "category": "CodeM",
        "icon": "$(add)"
      },
      {
        "command": "codem.historyButtonClicked",
        "title": "History",
        "category": "CodeM",
        "icon": "$(history)"
      },
      {
        "command": "codem.profileButtonClicked",
        "title": "Profile",
        "category": "CodeM",
        "icon": "$(account)"
      },
      {
        "command": "codem.settingsButtonClicked",
        "title": "Settings",
        "category": "CodeM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codem.signIn",
        "title": "Sign In or Register",
        "category": "CodeM"
      },
      {
        "command": "codem.signOut",
        "title": "Sign Out",
        "category": "CodeM"
      },
      {
        "command": "codem.refreshAuthentication",
        "title": "Refresh Authentication",
        "category": "CodeM"
      },
      {
        "command": "codem.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "codem.sidebarTitle.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "codem.sidebarTitle.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "codem.sidebarTitle.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codem.sidebarTitle.plusButtonClicked",
          "when": "view == codem.SidebarProvider",
          "group": "navigation@1"
        },
        {
          "command": "codem.sidebarTitle.historyButtonClicked",
          "when": "view == codem.SidebarProvider",
          "group": "navigation@2"
        },
        {
          "command": "codem.sidebarTitle.profileButtonClicked",
          "when": "view == codem.SidebarProvider",
          "group": "navigation@3"
        },
        {
          "command": "codem.sidebarTitle.settingsButtonClicked",
          "when": "view == codem.SidebarProvider",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "CodeM",
      "properties": {
        "codem.model": {
          "type": "string",
          "default": "codem/auto",
          "description": "Model selected for newly started CodeM threads."
        },
        "codem.intelligence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "medium",
          "description": "Reasoning effort for newly started CodeM threads."
        },
        "codem.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "auto",
            "yolo"
          ],
          "default": "auto",
          "description": "Core-owned permission mode for newly started CodeM threads."
        },
        "codem.workMode": {
          "type": "string",
          "enum": [
            "default",
            "plan"
          ],
          "default": "default",
          "description": "Work mode for newly started CodeM threads."
        }
      }
    }
  },
  "scripts": {
    "prepare:app-server-runtime": "bun script/prepare-app-server-runtime.ts",
    "build:launch": "pnpm run prepare:app-server-runtime && pnpm run build:check:production",
    "compile": "pnpm run prepare:app-server-runtime && pnpm run build:check",
    "watch": "pnpm run watch:esbuild",
    "watch:esbuild": "pnpm run prepare:app-server-runtime && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run prepare:app-server-runtime && pnpm run build:check:production",
    "package:dev": "pnpm run package && bun script/package-dev.ts",
    "build:check": "pnpm run check-types && pnpm run check-types:webview && pnpm run lint && pnpm run bundle",
    "build:check:production": "pnpm run check-types && pnpm run check-types:webview && pnpm run lint && pnpm run bundle:production",
    "bundle": "bun esbuild.js",
    "bundle:production": "bun esbuild.js --production",
    "check-types": "tsgo --noEmit",
    "check-types:webview": "tsgo --noEmit --project webview-ui/codem/tsconfig.json",
    "typecheck": "pnpm run check-types && pnpm run check-types:webview",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint src/extension.ts src/CodeMProvider.ts src/services/app-server src/shared/codem-webview.ts webview-ui/codem",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extension": "bun script/launch.ts",
    "extension:isolated": "bun script/launch.ts --isolated",
    "extension:isolated:clean": "bun script/launch.ts --isolated --clean"
  },
  "dependencies": {
    "@codem/app-server": "workspace:*",
    "@codem/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "@types/node": "22.x",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "^1.105.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
