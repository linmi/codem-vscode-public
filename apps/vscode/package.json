{
  "name": "codem",
  "displayName": "CodeM",
  "description": "Development build of the CodeM editor client for VS Code.",
  "version": "0.1.14",
  "icon": "assets/icons/codem.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "codem",
  "repository": {
    "type": "git",
    "url": "https://github.com/linmi/codem-vscode.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "CodeM"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "codem",
    "CodeM",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "opencode",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "codem-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "codem-logo": {
        "description": "CodeM logo",
        "default": {
          "fontPath": "assets/icons/codem-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codem-ActivityBar",
          "title": "CodeM",
          "icon": "assets/icons/codem-light.svg",
          "darkIcon": "assets/icons/codem-dark.svg"
        }
      ]
    },
    "views": {
      "codem-ActivityBar": [
        {
          "type": "webview",
          "id": "codem.SidebarProvider",
          "name": "CodeM"
        }
      ]
    },
    "commands": [
      {
        "command": "codem.selectSpace",
        "title": "Select Space",
        "category": "CodeM",
        "icon": "$(organization)"
      },
      {
        "command": "codem.plusButtonClicked",
        "title": "New Task",
        "category": "CodeM",
        "icon": "$(add)"
      },
      {
        "command": "codem.agentManagerOpen",
        "title": "Agent Manager",
        "category": "CodeM",
        "icon": "$(organization)"
      },
      {
        "command": "codem.historyButtonClicked",
        "title": "History",
        "category": "CodeM",
        "icon": "$(history)"
      },
      {
        "command": "codem.profileButtonClicked",
        "title": "Profile",
        "category": "CodeM",
        "icon": "$(account)"
      },
      {
        "command": "codem.signIn",
        "title": "Sign In or Register",
        "category": "CodeM"
      },
      {
        "command": "codem.signOut",
        "title": "Sign Out",
        "category": "CodeM"
      },
      {
        "command": "codem.refreshAuthentication",
        "title": "Refresh Authentication",
        "category": "CodeM"
      },
      {
        "command": "codem.settingsButtonClicked",
        "title": "Settings",
        "category": "CodeM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codem.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "codem.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "codem.sidebarTitle.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "codem.sidebarTitle.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "codem.sidebarTitle.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codem.openInTab",
        "title": "Open in Tab",
        "category": "CodeM",
        "icon": {
          "light": "assets/icons/codem-light.svg",
          "dark": "assets/icons/codem-dark.svg"
        }
      },
      {
        "command": "codem.showChanges",
        "title": "Show Changes",
        "category": "CodeM"
      },
      {
        "command": "codem.showMemory",
        "title": "Show Project Memory",
        "category": "CodeM"
      },
      {
        "command": "codem.toggleMemory",
        "title": "Toggle Project Memory",
        "category": "CodeM"
      },
      {
        "command": "codem.toggleCaffeination",
        "title": "Toggle Keep Awake",
        "category": "CodeM"
      },
      {
        "command": "codem.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "CodeM"
      },
      {
        "command": "codem.autocomplete.cancelSuggestions",
        "title": "Cancel Suggested Edits",
        "category": "CodeM"
      },
      {
        "command": "codem.autocomplete.nextEdit.acceptOrJump",
        "title": "Next Edit: Accept or Jump to Suggested Edit",
        "category": "CodeM"
      },
      {
        "command": "codem.autocomplete.nextEdit.dismiss",
        "title": "Next Edit: Dismiss Pending Suggestion",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.previousTerminal",
        "title": "Agent Manager: Previous Terminal",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.nextTerminal",
        "title": "Agent Manager: Next Terminal",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "CodeM",
        "icon": "$(terminal)"
      },
      {
        "command": "codem.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "CodeM",
        "icon": "$(play)"
      },
      {
        "command": "codem.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "CodeM",
        "icon": "$(diff)"
      },
      {
        "command": "codem.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "CodeM",
        "icon": "$(keyboard)"
      },
      {
        "command": "codem.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.newTerminalTab",
        "title": "Agent Manager: New Terminal Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.newSideTerminal",
        "title": "Agent Manager: New Sidebar Terminal Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.newWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.quickWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.updateFromBase",
        "title": "Agent Manager: Update from base",
        "category": "CodeM",
        "enablement": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.openPR",
        "title": "Agent Manager: Open Pull Request",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.advancedWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "CodeM"
      },
      {
        "command": "codem.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "CodeM"
      },
      {
        "command": "codem.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "CodeM",
        "icon": {
          "light": "assets/icons/codem-light.svg",
          "dark": "assets/icons/codem-dark.svg"
        }
      },
      {
        "command": "codem.explainCode",
        "title": "Explain Code",
        "category": "CodeM"
      },
      {
        "command": "codem.fixCode",
        "title": "Fix Code",
        "category": "CodeM"
      },
      {
        "command": "codem.improveCode",
        "title": "Improve Code",
        "category": "CodeM"
      },
      {
        "command": "codem.addToContext",
        "title": "Add to Context",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalFixCommand",
        "title": "Fix This Command",
        "category": "CodeM"
      },
      {
        "command": "codem.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "CodeM"
      },
      {
        "command": "codem.focusChatInput",
        "title": "Focus Chat Input",
        "category": "CodeM"
      },
      {
        "command": "codem.toggleChatSearch",
        "title": "Toggle Chat Search",
        "category": "CodeM"
      },
      {
        "command": "codem.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "CodeM"
      },
      {
        "command": "codem.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "CodeM"
      },
      {
        "command": "codem.selectPermissionMode",
        "title": "Select Thread Permission Mode",
        "category": "CodeM"
      },
      {
        "command": "codem.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "CodeM"
      },
      {
        "command": "codem.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "CodeM"
      },
      {
        "command": "codem.reload",
        "title": "Reload Config and Skills",
        "category": "CodeM"
      }
    ],
    "submenus": [
      {
        "id": "codem.editorContextMenu",
        "label": "CodeM"
      },
      {
        "id": "codem.terminalContextMenu",
        "label": "CodeM"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codem.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "codem.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "codem.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "codem.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "codem.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "codem.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "codem.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == codem.SidebarProvider && !codem.isCursor"
        },
        {
          "command": "codem.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == codem.SidebarProvider && !codem.isCursor"
        },
        {
          "command": "codem.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == codem.SidebarProvider && !codem.isCursor"
        },
        {
          "command": "codem.sidebarTitle.profileButtonClicked",
          "group": "navigation@5",
          "when": "view == codem.SidebarProvider && !codem.isCursor"
        },
        {
          "command": "codem.sidebarTitle.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == codem.SidebarProvider && !codem.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "codem.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "codem.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "codem.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "codem.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == codem.TabPanel && !codem.isCursor"
        },
        {
          "command": "codem.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == codem.TabPanel && !codem.isCursor"
        },
        {
          "command": "codem.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == codem.TabPanel && !codem.isCursor"
        },
        {
          "command": "codem.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == codem.TabPanel && !codem.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "codem.editorContextMenu",
          "group": "1_codem"
        }
      ],
      "codem.editorContextMenu": [
        {
          "command": "codem.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "codem.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "codem.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "codem.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "codem.terminalContextMenu",
          "group": "2_codem"
        }
      ],
      "codem.terminalContextMenu": [
        {
          "command": "codem.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "codem.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "codem.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codem.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "codem.selectPermissionMode",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "codem.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "codem.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "codem.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "codem.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "codem.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && !codem.sidebarFocused"
      },
      {
        "command": "codem.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "codem.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && !codem.agentManagerSideTerminalFocused"
      },
      {
        "command": "codem.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && !codem.agentManagerSideTerminalFocused"
      },
      {
        "command": "codem.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel' && codem.agentManagerSideTerminalFocused"
      },
      {
        "command": "codem.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'codem.AgentManagerPanel'"
      },
      {
        "command": "codem.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "codem.sidebarFocused || activeWebviewPanelId == 'codem.AgentManagerPanel' || activeWebviewPanelId == 'codem.TabPanel'"
      },
      {
        "command": "codem.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "codem.sidebarFocused || activeWebviewPanelId == 'codem.AgentManagerPanel' || activeWebviewPanelId == 'codem.TabPanel'"
      },
      {
        "command": "codem.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && codem.autocomplete.hasSuggestions"
      },
      {
        "command": "codem.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && codem.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "codem.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && codem.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "codem.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && codem.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "codem.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && codem.nextEdit.hasPendingSuggestion"
      }
    ],
