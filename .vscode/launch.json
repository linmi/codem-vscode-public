{
  "version": "0.2.0",
  "configurations": [{
    "name": "CodeM Native Chat (Experimental 1.138)",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode/dist/nativeChat", "--enable-proposed-api=codem.codem-native-experiment"],
    "outFiles": ["${workspaceFolder}/apps/vscode/dist/nativeChat/*.cjs"],
    "preLaunchTask": "Build CodeM Native Chat"
  }, {
    "name": "CodeM VS Code",
    "type": "extensionHost",
    "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
    "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.cjs"],
    "preLaunchTask": "Build CodeM VS Code"
  }]
}
