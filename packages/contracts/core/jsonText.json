    {"name":"numbers","text":"[0,-0,1,-1,1.5,1e2,1E+2,1e-2,0.5e1,123456789]","expected":{"kind":"accepted","value":[0,0,1,-1,1.5,100,100,0.01,5,123456789]}},
    {"name":"number-range-edge","text":"1e308","expected":{"kind":"accepted","value":1e+308}},
    {"name":"short-escapes","text":"\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"","expected":{"kind":"accepted","value":"\"\\/\b\f\n\r\t"}},
    {"name":"unicode-escape","text":"\"\\u0041\\u00e9\\u4E2D\"","expected":{"kind":"accepted","value":"A\u00e9\u4e2d"}},
    {"name":"surrogate-pair-escape","text":"\"\\ud83d\\ude00\"","expected":{"kind":"accepted","value":"\ud83d\ude00"}},
    {"name":"raw-non-bmp","text":"\"\ud83d\ude00\"","expected":{"kind":"accepted","value":"\ud83d\ude00"}},
    {"name":"lone-surrogate-escape","text":"\"\\ud800\"","expected":{"kind":"accepted","value":"\ud800"}},
